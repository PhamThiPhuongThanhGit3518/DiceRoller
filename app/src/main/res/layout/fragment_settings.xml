<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:fitsSystemWindows="true">

    <!-- Common Top Bar -->
    <com.phuongthanh.diceroller.core.widget.CommonTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:showBackButton="true"
        app:topbarSubtitle="@string/settings_screen_subtitle"
        app:topbarTitle="@string/settings_screen_title" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Banner: Premium Upgrade with Glowing Border & Drop Shadow -->
            <com.phuongthanh.diceroller.core.widget.FigmaCardView
                android:id="@+id/bannerPremium"
                android:layout_width="match_parent"
                android:layout_height="235dp"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/bg_settings_banner"
                android:focusable="true">

                <!-- Right Graphic: 3D Crown Dice -->
                <ImageView
                    android:id="@+id/imgPremiumDice"
                    android:layout_width="230dp"
                    android:layout_height="205dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Premium Dice"
                    android:scaleType="fitEnd"
                    android:src="@drawable/png_pro_setting"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Left Content: Heading + Button -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/imgPremiumDice"
                    app:layout_constraintEnd_toStartOf="@+id/imgPremiumDice"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvPremiumHeading"
                        android:layout_width="145dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/settings_premium_upgrade_title"
                        android:textColor="@color/ui_text_white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btnUpgrade"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_upgrade_gradient"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:outlineAmbientShadowColor="@color/ui_btn_shadow"
                        android:outlineSpotShadowColor="@color/ui_btn_shadow"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/settings_premium_upgrade_btn"
                            android:textColor="@color/ui_text_white"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Forward"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ui_text_white" />
                    </LinearLayout>
                </LinearLayout>

            </com.phuongthanh.diceroller.core.widget.FigmaCardView>

            <!-- Settings Options Card List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- Item 1: Change Language -->
                <LinearLayout
                    android:id="@+id/cardLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_settings_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#200A2459"
                    android:outlineSpotShadowColor="#400A2459"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:contentDescription="@string/settings_item_language"
                        android:src="@drawable/ic_language" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLanguageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_item_language"
                            android:textColor="@color/ui_text_white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvLanguageSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/ui_text_subtitle"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:text="English"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_right"
                        app:tint="@color/ui_chevron_tint" />
                </LinearLayout>

                <!-- Item 2: Share App -->
                <LinearLayout
                    android:id="@+id/cardShare"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_settings_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#200A2459"
                    android:outlineSpotShadowColor="#400A2459"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:contentDescription="@string/settings_item_share"
                        android:src="@drawable/ic_settings_share" />

                    <TextView
                        android:id="@+id/tvShareTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_item_share"
                        android:textColor="@color/ui_text_white"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_right"
                        app:tint="@color/ui_chevron_tint" />
                </LinearLayout>

                <!-- Item 3: Feedback -->
                <LinearLayout
                    android:id="@+id/cardFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_settings_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#200A2459"
                    android:outlineSpotShadowColor="#400A2459"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/settings_item_feedback"
                        android:src="@drawable/ic_settings_feedback" />

                    <TextView
                        android:id="@+id/tvFeedbackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_item_feedback"
                        android:textColor="@color/ui_text_white"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_right"
                        app:tint="@color/ui_chevron_tint" />
                </LinearLayout>

                <!-- Item 4: Privacy Policy -->
                <LinearLayout
                    android:id="@+id/cardPrivacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_settings_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#200A2459"
                    android:outlineSpotShadowColor="#400A2459"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/settings_item_privacy"
                        android:src="@drawable/ic_settings_privacy" />

                    <TextView
                        android:id="@+id/tvPrivacyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_item_privacy"
                        android:textColor="@color/ui_text_white"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_right"
                        app:tint="@color/ui_chevron_tint" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button: Next -->
    <LinearLayout
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_btn_next_gradient"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/ui_btn_shadow"
        android:outlineSpotShadowColor="@color/ui_btn_shadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/settings_btn_next"
            android:textColor="@color/ui_text_white"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Next"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/ui_text_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
