<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Common Top Bar -->
    <com.phuongthanh.diceroller.core.widget.CommonTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:showBackButton="true" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/ui_text_white"
                android:textSize="26sp"
                tools:text="Creat your own Dice game" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/custom_roll_header_subtitle"
                android:textColor="@color/ui_text_subtitle"
                android:textSize="14sp" />

            <!-- Hero Banner Card -->
            <ImageView
                android:id="@+id/ivHeroBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/custom_roll_title"
                android:src="@drawable/img_custom_roll_banner" />

            <!-- CTA Button: Create new game -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateNewGame"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_segmented_active_item"
                android:fontFamily="sans-serif-black"
                android:text="@string/custom_roll_new"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_game"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconTint="@color/white" />

            <!-- Title: Recent Games -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/custom_roll_recent"
                android:textColor="@color/ui_text_white"
                android:textSize="18sp" />

            <!-- Empty State Card (Dashed Border) -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashed_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="32dp"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:layout_width="184dp"
                    android:layout_height="147dp"
                    android:contentDescription="@string/custom_roll_empty"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_empty_recent_games" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/custom_roll_empty"
                    android:textColor="@color/ui_text_white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/custom_roll_empty_desc"
                    android:textColor="@color/ui_text_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Recent Games List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
