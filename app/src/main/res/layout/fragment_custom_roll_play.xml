<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Edge-to-Edge Custom Dice Arena Layout -->
    <com.phuongthanh.diceroller.features.customdice.widget.CustomDiceArenaLayout
        android:id="@+id/arenaLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Left: Back Button (Orange squircle) -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/btn_next"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Top Right: Help Button (Orange squircle) -->
    <ImageView
        android:id="@+id/btnHelp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/custom_play_help_title"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_question_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Left: Dice Mode / Roll Button (Orange squircle) -->
    <ImageView
        android:id="@+id/btnDiceMode"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/custom_play_roll_action"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_dice_multi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Center: Stepper (Minus, Count badge, Plus) -->
    <LinearLayout
        android:id="@+id/layoutStepperContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSettings"
        app:layout_constraintStart_toEndOf="@+id/btnDiceMode">

        <ImageView
            android:id="@+id/btnMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_stepper_green"
            android:contentDescription="Minus"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/ic_minus_white" />

        <TextView
            android:id="@+id/tvDiceCount"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_stepper_count_pill"
            android:elevation="2dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="8" />

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_stepper_green"
            android:contentDescription="Plus"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <!-- Bottom Right: Settings Button (Orange squircle) -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/dice_settings_title"
        android:elevation="6dp"
        android:padding="11dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
