<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Subtle divider / border -->
    <View
        android:id="@+id/vBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_die_cell_border" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/layoutDieContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Circular White Card for Image -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageContainer"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="48dp"
            app:cardElevation="4dp"
            app:strokeColor="#22000000"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivFaceImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_crown" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Emoji Display with Uniform Auto-sizing -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFaceEmoji"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeMaxTextSize="72sp"
            app:autoSizeStepGranularity="2sp"
            tools:text="👦" />

        <!-- Text Display with Auto-Sizing so text is NEVER truncated or clipped -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFaceText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#101828"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="40sp"
            app:autoSizeStepGranularity="1sp"
            tools:text="abc" />

    </LinearLayout>

</FrameLayout>
