<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar: Back Button, Title, Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_back"
            android:contentDescription="@string/btn_cancel"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/custom_roll_customize_dice"
                android:textColor="@color/ui_text_white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/custom_roll_subtitle_placeholder"
                android:textColor="@color/ui_text_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_2_2"
            android:textColor="@color/ui_text_subtitle"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Step 1 Inactive Dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_step_inactive" />

            <!-- Step 2 Active Pill -->
            <View
                android:layout_width="32dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_step_active" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title: Number of Dice face -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/number_of_dice_face"
                android:textColor="@color/ui_text_white"
                android:textSize="18sp" />

            <!-- Stepper: Number of Dice face -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stepper_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:id="@+id/btnMinusFaces"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Minus"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFacesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/ui_text_white"
                    android:textSize="18sp"
                    tools:text="6" />

                <FrameLayout
                    android:id="@+id/btnPlusFaces"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Plus"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Title: Dice face -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/dice_face_title"
                android:textColor="@color/ui_text_white"
                android:textSize="18sp" />

            <!-- Stepper: Dice face navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stepper_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:id="@+id/btnPrevFace"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Previous"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCurrentFaceIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/ui_text_white"
                    android:textSize="18sp"
                    tools:text="1/6" />

                <FrameLayout
                    android:id="@+id/btnNextFace"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Next"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Face Customizer Card (Figma Screen 3 Design) -->
            <LinearLayout
                android:id="@+id/cardCustomizeCurrentFace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashed_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="210dp"
                android:orientation="vertical"
                android:paddingVertical="24dp"
                android:paddingHorizontal="20dp">

                <!-- Placeholder state matching Figma Loot Box -->
                <LinearLayout
                    android:id="@+id/layoutEmptyFace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="90dp"
                        android:contentDescription="@string/custom_roll_empty"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_empty_recent_games" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/custom_roll_empty"
                        android:textColor="@color/ui_text_white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/custom_roll_empty_desc"
                        android:textColor="@color/ui_text_subtitle"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Customized content state -->
                <LinearLayout
                    android:id="@+id/layoutCustomizedFace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivFaceIconOrAdd"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Face Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_add"
                        app:tint="#3189FF" />

                    <TextView
                        android:id="@+id/tvFaceContentPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/ui_text_white"
                        android:textSize="16sp"
                        tools:text="Custom Face" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Bottom Auxiliary Squircle Button -->
        <FrameLayout
            android:id="@+id/btnBottomAux"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ic_back"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Format"
                android:src="@drawable/ic_edit"
                app:tint="@color/ui_text_subtitle" />
        </FrameLayout>

        <!-- CTA Button: Create new game -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_upgrade_gradient"
            android:fontFamily="sans-serif-black"
            android:text="@string/custom_roll_new"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@null"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_game"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
