<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle bar indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_indicator_inactive" />

    <!-- Pack Name Label -->
    <TextView
        android:id="@+id/tvPackName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="CLASSIC PARTY" />

    <!-- Challenge Type Badge -->
    <TextView
        android:id="@+id/tvQuestionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_featured"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="FUNNY QUESTIONS" />

    <!-- Challenge Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="26dp"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Điều ngốc nghếch nhất bạn từng làm khi say là gì?" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Roll Again Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRollAgain"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_roll_again"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:strokeColor="#E5E7EB" />

        <!-- Done Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#181A1F"
            android:text="@android:string/ok"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp" />
    </LinearLayout>

</LinearLayout>
