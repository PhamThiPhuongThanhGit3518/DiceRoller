<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_player_p1"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Player Badge (P1) on Left, Winner Trophy / Locked on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top-Left Player Pill Badge -->
        <LinearLayout
            android:id="@+id/layoutPlayerPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_avatar_player_p1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivPlayerIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_people"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="P1" />
        </LinearLayout>

        <!-- Top-Right Winner Badge -->
        <ImageView
            android:id="@+id/ivWinnerTrophy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Winner"
            android:src="@drawable/ic_trophy"
            android:visibility="gone"
            app:tint="#F59E0B"
            tools:visibility="visible" />

        <!-- Top-Right Locked Badge -->
        <FrameLayout
            android:id="@+id/layoutLockedBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_locked_badge"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="Locked"
                android:src="@drawable/ic_lock"
                app:tint="@color/white" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Center: Dice Container Area -->
    <FrameLayout
        android:id="@+id/containerDice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="4dp"
        android:layout_weight="1">

        <com.phuongthanh.diceroller.core.widget.Dice3DView
            android:id="@+id/diceCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom: Score Pill (Total sum) -->
    <LinearLayout
        android:id="@+id/cardScorePill"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="96dp"
        android:background="@drawable/bg_score_pill_player_p1"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_label_colon"
            android:textColor="#BCDDFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/player_p1_pink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="6" />
    </LinearLayout>

</LinearLayout>
