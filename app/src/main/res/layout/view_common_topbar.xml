<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTopBarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:minHeight="48dp"
    android:paddingTop="37dp"
    android:paddingHorizontal="20dp">

    <!-- Back Button (Figma Squircle 40x40dp) -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_back"
        android:contentDescription="Back"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center/Left Title & Subtitle Container -->
    <LinearLayout
        android:id="@+id/layoutTitleGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layoutRightActions"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ui_text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Customize the dice" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ui_text_subtitle"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Sub title"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Right Actions Container (Tối đa 2 actions) -->
    <LinearLayout
        android:id="@+id/layoutRightActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Action 1 (Bên trái) -->
        <FrameLayout
            android:id="@+id/containerAction1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_segmented_active_item"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnAction1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_queen" />
        </FrameLayout>

        <!-- Action 2 (Ngoài cùng bên phải) -->
        <FrameLayout
            android:id="@+id/containerAction2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_squircle_midnight_btn"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnAction2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_setting" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
