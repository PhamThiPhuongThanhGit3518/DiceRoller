<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border Layer: 1dp Horizontal Gradient Stroke (Cyan to Blue) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/ui_btn_stroke_start"
                android:endColor="@color/ui_btn_stroke_end" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Fill Layer: Horizontal Linear Gradient Inset by 1dp -->
    <item
        android:bottom="0.7dp"
        android:left="0.7dp"
        android:right="0.7dp"
        android:top="0.7dp">
        <shape android:shape="rectangle">
            <solid android:color="#191654"/>
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
