<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Edge-to-Edge Grid 3D Dice Surface -->
    <com.phuongthanh.diceroller.core.widget.Dice3DView
        android:id="@+id/diceCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Left: Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/btn_next"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Top Center: Total Score Pill -->
    <LinearLayout
        android:id="@+id/cardTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_translucent_dark"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTotalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Total: 10" />
    </LinearLayout>

    <!-- Top Right: Help Button -->
    <ImageView
        android:id="@+id/btnHelp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/free_roll_help_title"
        android:elevation="6dp"
        android:padding="12dp"
        android:src="@drawable/ic_question_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Left: Roll Button -->
    <ImageView
        android:id="@+id/btnRoll"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/roll_action"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_dice_multi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Center: Stepper & Max Dice Hint -->
    <LinearLayout
        android:id="@+id/layoutStepperContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Stepper Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMinus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_stepper_green"
                android:contentDescription="Minus"
                android:elevation="2dp"
                android:padding="10dp"
                android:src="@drawable/ic_minus_white" />

            <TextView
                android:id="@+id/tvDiceCount"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_btn_stepper_green"
                android:elevation="2dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="9" />

            <ImageView
                android:id="@+id/btnPlus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_stepper_green"
                android:contentDescription="Plus"
                android:elevation="2dp"
                android:padding="10dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <!-- Max 9 Dices Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_translucent_dark"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/max_dice_hint"
                android:src="@drawable/ic_dice_d6"
                app:tint="#F79371" />

            <TextView
                android:id="@+id/tvMaxDiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/max_dice_hint"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Right: Settings Button -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_squircle_orange"
        android:contentDescription="@string/tab_settings"
        android:elevation="6dp"
        android:padding="11dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
