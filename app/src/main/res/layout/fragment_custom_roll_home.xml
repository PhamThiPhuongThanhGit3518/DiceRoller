<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_back"
            android:contentDescription="@string/btn_cancel"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/ui_text_white"
                android:textSize="26sp"
                tools:text="Creat your own Dice game" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/custom_roll_header_subtitle"
                android:textColor="@color/ui_text_subtitle"
                android:textSize="14sp" />

            <!-- Hero Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#243972"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/ivHeroBanner"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/custom_roll_title"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_custom_roll_banner" />
            </com.google.android.material.card.MaterialCardView>

            <!-- CTA Button: Create new game -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateNewGame"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_upgrade_gradient"
                android:fontFamily="sans-serif-black"
                android:text="@string/custom_roll_new"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_game"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/white" />

            <!-- Title: Recent Games -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/custom_roll_recent"
                android:textColor="@color/ui_text_white"
                android:textSize="18sp" />

            <!-- Empty State Card (Dashed Border) -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashed_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="32dp"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/custom_roll_empty"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_empty_recent_games" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/custom_roll_empty"
                    android:textColor="@color/ui_text_white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/custom_roll_empty_desc"
                    android:textColor="@color/ui_text_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Recent Games List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
