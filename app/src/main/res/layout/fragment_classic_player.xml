<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <!-- 1. Top Bar (Matching Wireframe) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_squircle_dark_button"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/many_players_title"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/many_players_subtitle"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- VIP Crown Action -->
        <FrameLayout
            android:id="@+id/btnVip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_squircle_light_button"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_crown"
                app:tint="#23272E" />
        </FrameLayout>

        <!-- Settings Action -->
        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_squircle_dark_button"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. Controls Row: player [ 2P | 3P | 4P ]   dice [ — ] [ 1 ] [ + ] -->
    <LinearLayout
        android:id="@+id/layoutControlsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- Label: player -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_stepper_label"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Segmented Toggle Group for 2P, 3P, 4P -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:checkedButton="@+id/btnMode4P"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMode2P"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="2P"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#E2E8F0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMode3P"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="3P"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#E2E8F0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMode4P"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="4P"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#E2E8F0" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Label: dice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/dice_stepper_label"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Stepper: Minus -->
        <FrameLayout
            android:id="@+id/btnMinusDice"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stepper_square_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Minus"
                android:src="@drawable/ic_minus_white"
                app:tint="#111827" />
        </FrameLayout>

        <!-- Stepper: Count Display -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_stepper_square_button">

            <TextView
                android:id="@+id/tvDiceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="1" />
        </FrameLayout>

        <!-- Stepper: Plus -->
        <FrameLayout
            android:id="@+id/btnPlusDice"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stepper_square_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Plus"
                android:src="@drawable/ic_add"
                app:tint="#111827" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3. Player Cards Grid (2x2 Grid) -->
    <LinearLayout
        android:id="@+id/layoutCardsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:splitMotionEvents="true">

        <!-- Top Row (Player 1, Player 2) -->
        <LinearLayout
            android:id="@+id/rowTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:splitMotionEvents="true">

            <FrameLayout
                android:id="@+id/framePlayer1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer1"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePlayer2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer2"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Row (Player 3, Player 4) -->
        <LinearLayout
            android:id="@+id/rowBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:splitMotionEvents="true">

            <FrameLayout
                android:id="@+id/framePlayer3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer3"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePlayer4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer4"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
