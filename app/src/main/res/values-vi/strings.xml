    <string name="intro_title_1">Đổ Xúc Xắc Chân Thực</string>
    <string name="intro_desc_1">Đổ một hoặc nhiều xúc xắc cùng lúc, tự tính tổng, âm thanh sống động và lắc máy để gieo.</string>
    <string name="intro_title_2">Đối Kháng &amp; Trò Chơi Tiệc Tùng</string>
    <string name="intro_desc_2">Thi đấu trực tiếp 1–4 người trên cùng một máy, Thật hay Thách và xúc xắc bàn nhậu cực vui.</string>
    <string name="intro_title_3">Tùy Biến Trò Chơi Xúc Xắc</string>
    <string name="intro_desc_3">Tự tay thiết kế bộ xúc xắc độc nhất với hình ảnh, văn bản và biểu tượng cảm xúc.</string>
    <string name="intro_title_4">Vòng Quay May Mắn</string>
    <string name="intro_desc_4">Quay bánh xe roulette ra quyết định dễ dàng, công bằng và tràn ngập niềm vui.</string>
