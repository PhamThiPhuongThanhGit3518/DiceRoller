<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAECF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Sector Color Indicator -->
        <View
            android:id="@+id/viewSectorColor"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_circle_color_solid" />

        <!-- Option Title -->
        <TextView
            android:id="@+id/tvOptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#101828"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Coffee" />

        <!-- Edit Icon Button -->
        <ImageButton
            android:id="@+id/btnEditOption"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit"
            android:src="@drawable/ic_edit"
            app:tint="#667085" />

        <!-- Delete Icon Button -->
        <ImageButton
            android:id="@+id/btnDeleteOption"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:src="@drawable/ic_trash"
            app:tint="#667085" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
