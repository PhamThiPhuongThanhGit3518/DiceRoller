<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight">

    <!-- Edge-to-Edge Grid 3D Dice Surface -->
    <com.phuongthanh.diceroller.core.widget.Dice3DView
        android:id="@+id/diceCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar: Back | Title & Subtitle | Crown | Settings -->
    <com.phuongthanh.diceroller.core.widget.CommonTopBar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:action1Icon="@drawable/ic_crown"
        app:action2Icon="@drawable/ic_settings"
        app:showBackButton="true"
        app:topbarSubtitle="@string/single_player_subtitle"
        app:topbarTitle="@string/single_player_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Total Score Pill (Above Bottom Bar) -->
    <LinearLayout
        android:id="@+id/cardTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_free_roll_total_pill"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dice_d6"
            app:tint="@color/free_roll_btn_dark" />

        <TextView
            android:id="@+id/tvTotalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/free_roll_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Total: 0" />
    </LinearLayout>

    <!-- Bottom Floating Control Pill (White Bar) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_free_roll_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Left: Roll Button -->
        <FrameLayout
            android:id="@+id/btnRoll"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_free_roll_dark_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/roll_action"
                android:src="@drawable/ic_dice_multi"
                app:tint="@color/white" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Center: Stepper Controls ([-] [3] [+]) -->
        <LinearLayout
            android:id="@+id/layoutStepperContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_free_roll_white_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Minus"
                    android:src="@drawable/ic_minus_white"
                    app:tint="@color/free_roll_btn_icon_grey" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvDiceCount"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_free_roll_white_box"
                android:gravity="center"
                android:textColor="@color/free_roll_text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="3" />

            <FrameLayout
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_free_roll_white_box"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Plus"
                    android:src="@drawable/ic_add"
                    app:tint="@color/free_roll_btn_icon_grey" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Right: Action Button (Quick Roll / Unlock All) -->
        <FrameLayout
            android:id="@+id/btnActionRight"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_free_roll_dark_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Action"
                android:src="@drawable/ic_lock"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
