<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginEnd="8dp">

    <!-- Swatch background view (rounded rectangle / squircle) -->
    <View
        android:id="@+id/viewColorCircle"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Selection Ring (white stroke with radius 10dp) -->
    <View
        android:id="@+id/viewSelectionRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_swatch_selection_ring"
        android:visibility="invisible" />

    <!-- Center Checkmark Icon for selected state -->
    <ImageView
        android:id="@+id/ivCheckmark"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/white" />

</FrameLayout>
