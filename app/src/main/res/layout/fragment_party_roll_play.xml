<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B0E659">

    <!-- ============================================== -->
    <!-- 1. ROLL SCREEN (Image 1)                       -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRollScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 3D Dice Surface -->
        <com.phuongthanh.diceroller.core.widget.Dice3DView
            android:id="@+id/diceCanvas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Big Center Number Display (like in Image 1) -->
        <TextView
            android:id="@+id/tvCenterNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="#BFFFFFFF"
            android:textSize="130sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="4" />

        <!-- Top Left: Back Button (Orange Squircle) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_squircle_orange"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Top Center: Pack Title Pill (like "Couple Dice" in Image 1) -->
        <LinearLayout
            android:id="@+id/cardPackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_dark_pack"
            android:elevation="6dp"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:paddingVertical="9dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvPackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Couple Dice" />
        </LinearLayout>

        <!-- Top Right: Help Button (Orange Squircle) -->
        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_btn_squircle_orange"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_question_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bottom Left: Dice Mode Button (Orange Squircle) -->
        <ImageView
            android:id="@+id/btnDiceMode"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_squircle_orange"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_dice_multi"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom Right: Settings Button (Orange Squircle) -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_squircle_orange"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. RESULT OVERLAY (Image 2)                    -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutResultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Result Top Bar: X, "Result", Home -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnCloseResult"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                app:tint="#111827" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/result_title"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnHomeResult"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_nav_home"
                app:tint="#111827" />
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp">

                <!-- "You Rolled" Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/you_rolled"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Green Squircle with Rolled Number -->
                <FrameLayout
                    android:id="@+id/cardResultBadge"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_roll_number_badge">

                    <TextView
                        android:id="@+id/tvResultNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="17" />
                </FrameLayout>

                <!-- Challenge Card with Green Border -->
                <LinearLayout
                    android:id="@+id/cardChallenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_challenge_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Badge: Flame + "Challenge" -->
                    <LinearLayout
                        android:id="@+id/layoutChallengeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_challenge_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_challenge_flame" />

                        <TextView
                            android:id="@+id/tvChallengeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/challenge_badge"
                            android:textColor="#059669"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Challenge Question / Dare in Quotes -->
                    <TextView
                        android:id="@+id/tvChallengeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="32dp"
                        android:paddingBottom="40dp"
                        android:textColor="#111827"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="&quot;Describe your perfect date night&quot;" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom: Green Pill "Roll Again" Button -->
        <FrameLayout
            android:id="@+id/btnRollAgain"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_btn_pill_green"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dice_multi"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_roll_again"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
