<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Semantic Theme Tokens according to docs/AGENTS.md -->
    <attr name="surfaceCardContainer" format="color" />
    <attr name="onSurfaceCardContainer" format="color" />
    <attr name="surfaceDialogContainer" format="color" />
    <attr name="onSurfaceDialogContainer" format="color" />
    <attr name="surfaceTextField" format="color" />
    <attr name="onSurfaceTextField" format="color" />
    <attr name="primaryText" format="color" />
    <attr name="secondaryText" format="color" />
    <attr name="border" format="color" />
    <attr name="colorSuccess" format="color" />
    <attr name="tableFeltColor" format="color" />

    <declare-styleable name="FigmaCardView">
        <attr name="cardCornerRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CommonTopBar">
        <attr name="topbarTitle" format="string" />
        <attr name="topbarSubtitle" format="string" />
        <attr name="showBackButton" format="boolean" />
        <attr name="action1Icon" format="reference" />
        <attr name="action2Icon" format="reference" />
        <attr name="applyStatusBarInsets" format="boolean" />
    </declare-styleable>

    <declare-styleable name="GradientBorderLayout">
        <attr name="gbStrokeWidth" format="dimension" />
        <attr name="gbCornerRadius" format="dimension" />
        <attr name="gbStartColor" format="color" />
        <attr name="gbEndColor" format="color" />
        <attr name="gbFillColor" format="color" />
    </declare-styleable>
</resources>
