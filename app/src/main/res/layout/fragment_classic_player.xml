<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:orientation="vertical">

    <!-- 1. Top Bar -->
    <com.phuongthanh.diceroller.core.widget.CommonTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:action1Icon="@drawable/ic_crown"
        app:action2Icon="@drawable/ic_settings"
        app:showBackButton="true"
        app:topbarSubtitle="@string/many_players_subtitle"
        app:topbarTitle="@string/many_players_title" />

    <!-- 2. Top Control Card (Players Selector & Dice Stepper) -->
    <com.phuongthanh.diceroller.core.widget.GradientBorderLayout
        android:id="@+id/layoutControlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="32dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp"
        app:gbCornerRadius="12dp"
        app:gbEndColor="#0075FB"
        app:gbStartColor="#00CAFB"
        app:gbStrokeWidth="1.5dp">

        <!-- Row 1: Players Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:text="@string/player_stepper_label"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Segmented Control Container -->
            <LinearLayout
                android:id="@+id/layoutSegmentedMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_segmented_container"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMode2P"
                    android:layout_width="74.67dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="2P"
                    android:textColor="@color/segmented_ctrl_inactive_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMode3P"
                    android:layout_width="74.67dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="3P"
                    android:textColor="@color/segmented_ctrl_inactive_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMode4P"
                    android:layout_width="74.67dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segmented_active_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="4P"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Dice Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:text="@string/dice_stepper_label"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Dice Stepper Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_dice_pill_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <FrameLayout
                    android:id="@+id/btnMinusDice"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Minus"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/white" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dice_stepper_val">

                    <TextView
                        android:id="@+id/tvDiceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="1" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnPlusDice"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Plus"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.phuongthanh.diceroller.core.widget.GradientBorderLayout>

    <!-- 3. Player Cards Grid (2x2 Grid) -->
    <LinearLayout
        android:id="@+id/layoutCardsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:splitMotionEvents="true">

        <!-- Top Row (Player 1, Player 2) -->
        <LinearLayout
            android:id="@+id/rowTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:splitMotionEvents="true">

            <FrameLayout
                android:id="@+id/framePlayer1"
                android:layout_width="0dp"
                android:layout_height="213.8dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer1"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePlayer2"
                android:layout_width="0dp"
                android:layout_height="213.8dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer2"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Row (Player 3, Player 4) -->
        <LinearLayout
            android:id="@+id/rowBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:splitMotionEvents="true">

            <FrameLayout
                android:id="@+id/framePlayer3"
                android:layout_width="0dp"
                android:layout_height="213.8dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer3"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePlayer4"
                android:layout_width="0dp"
                android:layout_height="213.8dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/slotPlayer4"
                    layout="@layout/item_many_players_card" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
