<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_midnight"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Common Top Bar -->
    <com.phuongthanh.diceroller.core.widget.CommonTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:showBackButton="true"
        app:topbarSubtitle="@string/custom_roll_subtitle_placeholder"
        app:topbarTitle="@string/custom_roll_customize_dice" />

    <!-- Step Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_1_2"
            android:textColor="@color/ui_text_subtitle"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Step 1 Active Pill -->
            <View
                android:layout_width="32dp"
                android:layout_height="5dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_step_active" />

            <!-- Step 2 Inactive Dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_step_inactive" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center: Live Dice Preview from Figma -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/ivDicePreview"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cat_custom_dice"
            android:scaleType="fitCenter"
            android:src="@drawable/img_custom_dice_preview" />

        <LinearLayout
            android:id="@+id/layoutDicePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Controls Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/how_many_dice"
            android:textColor="@color/ui_text_white"
            android:textSize="18sp" />

        <!-- Stepper Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stepper_capsule_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnMinusDice"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Minus"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_stepper_inner_box">

                    <TextView
                        android:id="@+id/tvDiceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/ui_text_white"
                        android:textSize="18sp"
                        tools:text="3" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnPlusDice"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Plus"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_continue_blue"
            android:fontFamily="sans-serif-black"
            android:text="@string/btn_continue_lower"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@null"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
