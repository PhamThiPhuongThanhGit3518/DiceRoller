<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border Layer: 1dp Vertical Gradient Stroke (Purple to Royal Blue) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/ui_banner_stroke_top"
                android:endColor="@color/ui_banner_stroke_bottom" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Fill Layer: Diagonal Linear Gradient Inset by 1dp -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/ui_banner_start"
                android:centerColor="@color/ui_banner_center"
                android:endColor="@color/ui_banner_end" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>